# Application Configuration
PROJECT_NAME="Demolition Intelligence & Material Recovery"
ENVIRONMENT=development
API_V1_STR=/api/v1
DEBUG=True

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=demolition_user
POSTGRES_PASSWORD=demolition_secure_password
POSTGRES_DB=demolition_intelligence
# Async URL used by FastAPI / SQLAlchemy AsyncSession
DATABASE_URL=postgresql+asyncpg://demolition_user:demolition_secure_password@localhost:5432/demolition_intelligence
# Sync URL used by Alembic migrations
DATABASE_SYNC_URL=postgresql://demolition_user:demolition_secure_password@localhost:5432/demolition_intelligence

# Redis & Celery Asynchronous Job Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3-Compatible Object Storage (MinIO in local dev, AWS S3 / Cloudflare R2 in prod)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=demolition-surveys
S3_REGION=us-east-1
S3_USE_SSL=False

# Generative AI (OpenAI API for Demolition Audit Reports)
OPENAI_API_KEY=sk-placeholder-insert-your-api-key-here
OPENAI_MODEL=gpt-4o

# Computer Vision & AI Models
YOLO_MODEL_PATH=ai_pipeline/weights/demolition_materials_yolov8.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

